--- a/src/freedreno/vulkan/tu_knl.cc
+++ b/src/freedreno/vulkan/tu_knl.cc
@@ -114,6 +114,34 @@ tu_bo_init_dmabuf(struct tu_device *dev,
    return VK_SUCCESS;
 }
 
+VkResult
+tu_bo_init_userptr(struct tu_device *dev,
+                   struct tu_bo **bo,
+                   void *host_ptr,
+                   uint64_t size,
+                   VkMemoryPropertyFlags mem_property)
+{
+   if (!dev->instance->knl->bo_init_userptr)
+      return vk_error(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   if (((uintptr_t) host_ptr | size) & (os_page_size - 1))
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "host pointer or size not page-aligned");
+
+   VkResult result = dev->instance->knl->bo_init_userptr(dev, bo, host_ptr,
+                                                         size, mem_property);
+   if (result != VK_SUCCESS)
+      return result;
+
+   if ((mem_property & VK_MEMORY_PROPERTY_HOST_CACHED_BIT) &&
+       !(mem_property & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT))
+      (*bo)->cached_non_coherent = true;
+
+   if (!(*bo)->unique_id)
+      (*bo)->unique_id = (*bo)->gem_handle;
+
+   return VK_SUCCESS;
+}
