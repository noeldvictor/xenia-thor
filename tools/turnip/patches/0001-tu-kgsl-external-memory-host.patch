diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index 44af0c22..31b1e097 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -434,6 +434,79 @@ kgsl_bo_init_dmabuf(struct tu_device *dev,
    return VK_SUCCESS;
 }
 
+/* VK_EXT_external_memory_host: KGSL maps the pages of an existing CPU
+ * mapping into the GPU (KGSL_USER_MEM_TYPE_ADDR, the path of Qualcomm's
+ * cl_qcom_ext_host_ptr). For USER_MEM_TYPE_ADDR, KGSL reads the length of the
+ * range from priv_len, not the size of the priv struct. The kernel pins the
+ * pages, so the whole range must be mapped read-write. Host memory is CPU
+ * cached; the GPU stays coherent with it only through IO coherence.
+ */
+static VkResult
+kgsl_bo_init_userptr(struct tu_device *dev,
+                     struct tu_bo **out_bo,
+                     void *host_ptr,
+                     uint64_t size,
+                     VkMemoryPropertyFlags mem_property)
+{
+   if (!(mem_property & VK_MEMORY_PROPERTY_HOST_CACHED_BIT) ||
+       !(mem_property & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) ||
+       !dev->physical_device->has_cached_coherent_memory)
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "host memory needs a cached coherent memory type");
+
+   struct kgsl_gpuobj_import_useraddr import_useraddr = {
+      .virtaddr = (uintptr_t) host_ptr,
+   };
+   struct kgsl_gpuobj_import req = {
+      .priv = (uintptr_t)&import_useraddr,
+      .priv_len = size,
+      .flags = KGSL_MEMFLAGS_IOCOHERENT |
+               (KGSL_CACHEMODE_WRITEBACK << KGSL_CACHEMODE_SHIFT),
+      .type = KGSL_USER_MEM_TYPE_ADDR,
+   };
+   int ret;
+
+   ret = safe_ioctl(dev->physical_device->local_fd,
+                    IOCTL_KGSL_GPUOBJ_IMPORT, &req);
+   if (ret)
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to import host memory (%s)\n", strerror(errno));
+
+   struct kgsl_gpuobj_info info_req = {
+      .id = req.id,
+   };
+
+   ret = safe_ioctl(dev->physical_device->local_fd,
+                    IOCTL_KGSL_GPUOBJ_INFO, &info_req);
+   if (ret) {
+      struct kgsl_gpumem_free_id free_req = { .id = req.id };
+      safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUMEM_FREE_ID,
+                 &free_req);
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to get host memory info (%s)\n",
+                       strerror(errno));
+   }
+
+   struct tu_bo* bo = tu_device_lookup_bo(dev, req.id);
+   assert(bo && bo->gem_handle == 0);
+
+   *bo = (struct tu_bo) {
+      .gem_handle = req.id,
+      .size = info_req.size,
+      .iova = info_req.gpuaddr,
+      .map = host_ptr,
+      .name = tu_debug_bos_add(dev, info_req.size, "host_ptr"),
+      .refcnt = 1,
+      .shared_fd = -1,
+      .never_unmap = true,
+      .userptr = true,
+   };
+
+   *out_bo = bo;
+
+   return VK_SUCCESS;
+}
