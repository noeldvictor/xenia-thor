# ==============================================================================
# PUBLIC REPO SAFETY NET
# ==============================================================================
# This repository is public. CLAUDE.md already says never to commit game
# content, keys, dumps or configs - these patterns enforce it, so a stray
# `git add` cannot leak them even by accident.

# Game content. Legal risk, and huge.
*.iso
*.xex
*.god
*.stfs
/SteamLibrary/

# Signing material and credentials. Never.
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
/keystore/
local.properties
google-services.json

# Emulator config, which carries local device paths and per-machine settings.
xenia.config.toml
*.config.backup.toml
_xenia.config.backup.toml

# Local build/scratch artifacts and captures.
/binary_cache/
*.pftrace
*.rdc

# edram_bench build artifacts (the arm64 binary and generated SPIR-V)
tools/edram_bench/edram_bench
tools/edram_bench/shaders/*.spv

# Session debris that lands in the repo ROOT. These were 60+ untracked
# entries, which is enough noise to hide a real change in `git status`.
# All three globs are root-anchored on purpose: 39 PNGs ARE tracked under
# docs/, and must stay that way.
/*.dll
/*.png
/*.obj
/scratchpad/
/tmp/

# Android build output.
android/android_studio_project/app/src/main/jniLibs/

# Dumped GUEST executable images. This is commercial game data - it must
# never enter the repo, however convenient the RE scripts beside it are.
tools/xex/*.bin

# Perf symbol map, regenerated per build.
xenia_perf.map

# Autonomous-loop RUNTIME control file, not configuration. Its presence is
# what keeps the Stop hook grinding, so committing it would ship the loop
# switched on to every checkout.
.claude/thor-loop-active
