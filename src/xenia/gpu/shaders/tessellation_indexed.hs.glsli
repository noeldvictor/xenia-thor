// Vulkan port of the discrete_* and continuous_* hull shaders (the control
// point pass-through and the factors are the same for both; the spacing,
// integer or fractional even, is an execution mode of the translated guest
// tessellation evaluation shader). The includer defines
// XE_TESSELLATION_CONTROL_POINT_COUNT.
#include "tessellation_vk.glsli"

layout(vertices = XE_TESSELLATION_CONTROL_POINT_COUNT) out;

layout(location = 0) in float xe_in_index[];
layout(location = 0) out float xe_out_index[];

void main() {
  xe_out_index[gl_InvocationID] = xe_in_index[gl_InvocationID];
  if (gl_InvocationID == 0) {
    // Xenos creates a uniform grid for triangles, but this can't be reproduced
    // using the host tessellator, so just use what has the closest level of
    // detail. 1.0 is already added to the factor on the CPU, according to the
    // images in
    // https://www.slideshare.net/blackdevilvikas/next-generation-graphics-programming-on-xbox-360
    // The unused levels of the triangle domain are ignored.
    float factor = xe_tessellation_factor_range.y;
    gl_TessLevelOuter[0] = factor;
    gl_TessLevelOuter[1] = factor;
    gl_TessLevelOuter[2] = factor;
    gl_TessLevelOuter[3] = factor;
    gl_TessLevelInner[0] = factor;
    gl_TessLevelInner[1] = factor;
  }
}
